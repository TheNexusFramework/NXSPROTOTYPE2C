        float adj_p = p_val + y_shift
        int st_t = time + (x_shift * 60000)
        int et_t = st_t + ((len_mode == "Uniform" ? master_len : l_val) * 60000)
        line.new(st_t, adj_p, et_t, adj_p, xloc=xloc.bar_time, color=c_val, width=flag_width, style=f_get_style(st_str))
        label.new(et_t, adj_p, nm + " " + str.tostring(adj_p, "#.00"), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.black, 100), textcolor=pr_col, size=f_get_size(pr_size_str))

get_dynamic_cb(price) =>
    price < 1.00 ? cb_tier_1 : price < 1.50 ? cb_tier_2 : price < 2.00 ? cb_tier_3 : price < 3.00 ? cb_tier_4 : price < 5.00 ? cb_tier_5 : price < 10.00 ? cb_tier_6 : price < 15.00 ? cb_tier_7 : cb_tier_8

f_draw_risk_cage(lvl, flag_c, e_id, exec_p, shift_x, shift_y) =>
    string prefix = e_id == 1 ? "E1" : e_id == 2 ? "E2" : "E3"
    if show_entry_lbl
        label.new(bar_index, low, text=prefix + " " + str.tostring(lvl), style=label.style_label_up, color=color.new(color.white, 100), textcolor=entry_col, size=f_get_size(entry_size_str))
    
    string t_str = str.format_time(time, "HH:mm:ss", "America/New_York")
    label.new(time, exec_p, t_str, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_right, color=color.new(color.black, 100), textcolor=ts_col, size=f_get_size(ts_size_str))

    float dyn_cb = get_dynamic_cb(exec_p)
    float mult_t6 = e_id == 1 ? e1_mult_t6 : e_id == 2 ? e2_mult_t6 : e3_mult_t6
    float mult_t5 = e_id == 1 ? e1_mult_t5 : e_id == 2 ? e2_mult_t5 : e3_mult_t5
    float mult_t4 = e_id == 1 ? e1_mult_t4 : e_id == 2 ? e2_mult_t4 : e3_mult_t4
    float mult_t3 = e_id == 1 ? e1_mult_t3 : e_id == 2 ? e2_mult_t3 : e3_mult_t3
    float mult_t2 = e_id == 1 ? e1_mult_t2 : e_id == 2 ? e2_mult_t2 : e3_mult_t2
    float mult_t1 = e_id == 1 ? e1_mult_t1 : e_id == 2 ? e2_mult_t1 : e3_mult_t1
    float mult_s1 = e_id == 1 ? e1_mult_s1 : e_id == 2 ? e2_mult_s1 : e3_mult_s1
    float mult_s2 = e_id == 1 ? e1_mult_s2 : e_id == 2 ? e2_mult_s2 : e3_mult_s2
    float mult_s3 = e_id == 1 ? e1_mult_s3 : e_id == 2 ? e2_mult_s3 : e3_mult_s3
    float dial    = e_id == 1 ? e1_dial : e_id == 2 ? e2_dial : e3_dial

    float p_t6 = exec_p + (dyn_cb * mult_t6 * dial), float p_t5 = exec_p + (dyn_cb * mult_t5 * dial), float p_t4 = exec_p + (dyn_cb * mult_t4 * dial), float p_t3 = exec_p + (dyn_cb * mult_t3 * dial), float p_t2 = exec_p + (dyn_cb * mult_t2 * dial), float p_t1 = exec_p + (dyn_cb * mult_t1 * dial)
    float p_b  = exec_p
    float p_s1 = exec_p - (dyn_cb * mult_s1 * dial), float p_s2 = exec_p - (dyn_cb * mult_s2 * dial), float p_s3 = exec_p - (dyn_cb * mult_s3 * dial)

    f_draw_level(show_t6, p_t6, len_t6, col_t6, tgt_style_str, "T6:", shift_x, shift_y)
    f_draw_level(show_t5, p_t5, len_t5, col_t5, tgt_style_str, "T5:", shift_x, shift_y)
    f_draw_level(show_t4, p_t4, len_t4, col_t4, tgt_style_str, "T4:", shift_x, shift_y)
    f_draw_level(show_t3, p_t3, len_t3, col_t3, tgt_style_str, "T3:", shift_x, shift_y)
    f_draw_level(show_t2, p_t2, len_t2, col_t2, tgt_style_str, "T2:", shift_x, shift_y)
    f_draw_level(show_t1, p_t1, len_t1, col_t1, tgt_style_str, "T1:", shift_x, shift_y)
    f_draw_level(show_base, p_b, len_base, flag_c, base_style_str, "Base:", shift_x, shift_y)
    f_draw_level(show_s1, p_s1, len_s1, col_s1, sub_style_str, "S1:", shift_x, shift_y)
    f_draw_level(show_s2, p_s2, len_s2, col_s2, sub_style_str, "S2:", shift_x, shift_y)
    f_draw_level(show_s3, p_s3, len_s3, col_s3, sub_style_str, "S3:", shift_x, shift_y)
    
    // Queue Visual Ticket
    if show_ticket
        float t_anch = ticket_anchor == "T6" ? p_t6 : ticket_anchor == "T5" ? p_t5 : ticket_anchor == "T4" ? p_t4 : ticket_anchor == "T3" ? p_t3 : ticket_anchor == "T2" ? p_t2 : ticket_anchor == "T1" ? p_t1 : ticket_anchor == "Base" ? p_b : ticket_anchor == "S1" ? p_s1 : ticket_anchor == "S2" ? p_s2 : p_s3
        float t_top = ticket_height >= 0 ? t_anch + ticket_height : t_anch
        float t_bot = ticket_height >= 0 ? t_anch : t_anch + ticket_height
        
        int eval_st_t = time + (shift_x * 60000)
        int draw_st_t = eval_st_t + (ticket_shift * 60000)
        
        array.push(pending_tk_anch, t_anch + shift_y)
        array.push(pending_tk_top, t_top + shift_y)
        array.push(pending_tk_bot, t_bot + shift_y)
        array.push(pending_tk_time, eval_st_t)
        array.push(pending_tk_draw_t, draw_st_t)

f_vwap_ok(c_val, ub3, ub2, ub1, vwap, lb1, lb2, lb3) =>
    float ref_val = mute_ref == "Upper Band 3" ? ub3 : mute_ref == "Upper Band 2" ? ub2 : mute_ref == "Upper Band 1" ? ub1 : mute_ref == "Lower Band 1" ? lb1 : mute_ref == "Lower Band 2" ? lb2 : mute_ref == "Lower Band 3" ? lb3 : vwap
    bool ok = true
    if mute_dir == "Mute if ABOVE Band" and c_val > ref_val
        ok := false
    if mute_dir == "Mute if BELOW Band" and c_val < ref_val
        ok := false
    ok

f_get_target_price(t_str, e_id, exec_p) =>
    float dyn_cb = get_dynamic_cb(exec_p)
    float dial = e_id == 1 ? e1_dial : e_id == 2 ? e2_dial : e3_dial
    float mult = 0.0
    if t_str == "T6"
        mult := e_id == 1 ? e1_mult_t6 : e_id == 2 ? e2_mult_t6 : e3_mult_t6
    else if t_str == "T5"
        mult := e_id == 1 ? e1_mult_t5 : e_id == 2 ? e2_mult_t5 : e3_mult_t5
    else if t_str == "T4"
        mult := e_id == 1 ? e1_mult_t4 : e_id == 2 ? e2_mult_t4 : e3_mult_t4
    else if t_str == "T3"
        mult := e_id == 1 ? e1_mult_t3 : e_id == 2 ? e2_mult_t3 : e3_mult_t3
    else if t_str == "T2"
        mult := e_id == 1 ? e1_mult_t2 : e_id == 2 ? e2_mult_t2 : e3_mult_t2
    else if t_str == "T1"
        mult := e_id == 1 ? e1_mult_t1 : e_id == 2 ? e2_mult_t1 : e3_mult_t1
    else if t_str == "S1"
        mult := -(e_id == 1 ? e1_mult_s1 : e_id == 2 ? e2_mult_s1 : e3_mult_s1)
    else if t_str == "S2"
        mult := -(e_id == 1 ? e1_mult_s2 : e_id == 2 ? e2_mult_s2 : e3_mult_s2)
    else if t_str == "S3"
        mult := -(e_id == 1 ? e1_mult_s3 : e_id == 2 ? e2_mult_s3 : e3_mult_s3)
    exec_p + (dyn_cb * mult * dial)

// Helper Functions for Combined Engine Alignment Check
f_is_sweeping(trackers) =>
    bool active = false
    if not na(trackers) and array.size(trackers) > 0
        for idx = 0 to array.size(trackers) - 1
            if array.get(trackers, idx).state == 1
                active := true
                break
    active

f_is_near_level(sp_arr, cur_h, cur_l, prox_tol) =>
    bool near = false
    if not na(sp_arr) and array.size(sp_arr) > 0
        for idx = 0 to array.size(sp_arr) - 1
            float lp = array.get(sp_arr, idx)
            if (cur_l <= lp + prox_tol and cur_h >= lp - prox_tol)
                near := true
                break
    near

// =============================================================================
// 📦 BLOCK 5: THE STATE MACHINE (THE BRAIN) & ALERT INJECTION
// =============================================================================
bool trig_1 = false, bool trig_2 = false, bool trig_3 = false
bool stg1_1 = false, bool stg1_2 = false, bool stg1_3 = false
bool stg1_sync = false

// Candidate Reclaim Holders for Combined Gate Evaluation
bool   cand_stg1_1 = false, float cand_lvl_1 = na, string cand_src_1 = "", float cand_swp_1 = 0.0, bool cand_ks_1 = false
bool   cand_stg1_2 = false, float cand_lvl_2 = na, string cand_src_2 = "", float cand_swp_2 = 0.0, bool cand_ks_2 = false

// Capture sweeping states across E1 & E2 prior to transition
bool e1_was_sweeping = f_is_sweeping(tr_1)
bool e2_was_sweeping = f_is_sweeping(tr_2)

// Arrays for Background Alert Tracking
varip int[] pending_vm_bars = array.new_int(0)
varip string[] pending_vm_msgs = array.new_string(0)
varip float[] active_nets = array.new_float(0)
varip string[] active_net_msgs = array.new_string(0)

// --- Process Engine 1 ---
if enable_e1 and not na(tr_1) and array.size(tr_1) > 0
    for i = 0 to array.size(tr_1) - 1
        LevelTracker tr = array.get(tr_1, i)
        float lvl = tr.price
        bool valid_app = appr_mode == "Strict (Lows > Level)" ? (min_l1_past > lvl) : (min_c1_past > lvl)
        bool struct_ok = use_struct ? (max_h1_past >= (lvl + tripwire_pts)) : true

        if tr.state == 0
            if valid_app and struct_ok and l1 <= lvl and (bar_index - tr.c_bar) >= cooldown
                tr.state := 1, tr.t_low := l1, tr.c_bar := bar_index
                e1_was_sweeping := true
                if alt_tripwire
                    f_alert("NXS E1: Tripwire Radar Alert at " + str.tostring(lvl), alert.freq_once_per_bar)
        else if tr.state == 1
            if l1 < tr.t_low
                tr.t_low := l1 
            if c1 >= (lvl + conf_1)
                bool sweep_ok = (lvl - tr.t_low) >= min_sweep
                if sweep_ok and not fired_e1_this_bar and barstate.isconfirmed
                    if use_vertical_line
                        if time > tr.last_stg1_time
                            cand_stg1_1 := true
                            cand_lvl_1  := lvl
                            cand_src_1  := tr.source
                            cand_swp_1  := lvl - tr.t_low
                            tr.stage1_bar := bar_index
                            tr.last_stg1_time := time
                            last_e1_reclaim_bar := bar_index
                            fired_e1_this_bar := true
                            if force_cage_stg1
                                if f_vwap_ok(c1, ub3_1, ub2_1, ub1_1, _vwap1, lb1_1, lb2_1, lb3_1)
                                    if time > tr.last_trig_time
                                        cand_ks_1 := true
                                        tr.c_bar := bar_index
                                        tr.last_trig_time := time
                                tr.state := 0 
                            else
                                tr.state := 2 
                    else
                        if f_vwap_ok(c1, ub3_1, ub2_1, ub1_1, _vwap1, lb1_1, lb2_1, lb3_1)
                            if time > tr.last_trig_time
                                trig_1 := true, fired_e1_this_bar := true, tr.c_bar := bar_index
                                tr.last_trig_time := time
                                last_e1_reclaim_bar := bar_index
                                f_draw_risk_cage(lvl, flag_col_e1, 1, close, 0, 0)
                                if alt_killshot
                                    f_alert("NXS E1: Killshot Validated at " + str.tostring(lvl), alert.freq_once_per_bar_close)
                                if use_vm
                                    line.new(bar_index + vm_shift, close - vm_ext_1, bar_index + vm_shift, close + vm_ext_1, color=vm_col, width=vm_thick)
                                if alt_line
                                    array.push(pending_vm_bars, bar_index + vm_shift), array.push(pending_vm_msgs, "NXS E1: Line in the Sand Crossed at " + str.tostring(lvl))
                                if alt_tap
                                    array.push(active_nets, f_get_target_price(alt_tap_line, 1, close)), array.push(active_net_msgs, "NXS E1: Risk Cage Tap at " + str.tostring(lvl))
                            tr.state := 0
        else if tr.state == 2
            if bar_index >= tr.stage1_bar + active_delay
                if c1 > lvl 
                    if not fired_e1_this_bar and barstate.isconfirmed
                        if f_vwap_ok(c1, ub3_1, ub2_1, ub1_1, _vwap1, lb1_1, lb2_1, lb3_1)
                            if time > tr.last_trig_time
                                trig_1 := true, fired_e1_this_bar := true, tr.c_bar := bar_index
                                tr.last_trig_time := time
                                f_draw_risk_cage(lvl, flag_col_e1, 1, close, 0, 0)
                                if alt_killshot
                                    f_alert("NXS E1: Killshot Validated at " + str.tostring(lvl), alert.freq_once_per_bar_close)
                                if use_vm
                                    line.new(bar_index + vm_shift, close - vm_ext_1, bar_index + vm_shift, close + vm_ext_1, color=vm_col, width=vm_thick)
                                if alt_line
                                    array.push(pending_vm_bars, bar_index + vm_shift), array.push(pending_vm_msgs, "NXS E1: Line in the Sand Crossed at " + str.tostring(lvl))
                                if alt_tap
                                    array.push(active_nets, f_get_target_price(alt_tap_line, 1, close)), array.push(active_net_msgs, "NXS E1: Risk Cage Tap at " + str.tostring(lvl))
                tr.state := 0 

// --- Process Engine 2 ---
if enable_e2 and not na(tr_2) and array.size(tr_2) > 0
    for i = 0 to array.size(tr_2) - 1
        LevelTracker tr = array.get(tr_2, i)
        float lvl = tr.price
        bool valid_app = appr_mode == "Strict (Lows > Level)" ? (min_l2_past > lvl) : (min_c2_past > lvl)
        bool struct_ok = use_struct ? (max_h2_past >= (lvl + tripwire_pts)) : true

        if tr.state == 0
            if valid_app and struct_ok and l2 <= lvl and (bar_index - tr.c_bar) >= cooldown
                tr.state := 1, tr.t_low := l2, tr.c_bar := bar_index
                e2_was_sweeping := true
                if alt_tripwire
                    f_alert("NXS E2: Tripwire Radar Alert at " + str.tostring(lvl), alert.freq_once_per_bar)
        else if tr.state == 1
            if l2 < tr.t_low
                tr.t_low := l2 
            if c2 >= (lvl + conf_2)
                bool sweep_ok = (lvl - tr.t_low) >= min_sweep
                if sweep_ok and not fired_e2_this_bar and barstate.isconfirmed
                    if use_vertical_line
                        if time > tr.last_stg1_time
                            cand_stg1_2 := true
                            cand_lvl_2  := lvl
                            cand_src_2  := tr.source
                            cand_swp_2  := lvl - tr.t_low
                            tr.stage1_bar := bar_index
                            tr.last_stg1_time := time
                            last_e2_reclaim_bar := bar_index
                            fired_e2_this_bar := true
                            if force_cage_stg1
                                if f_vwap_ok(c2, ub3_2, ub2_2, ub1_2, _vwap2, lb1_2, lb2_2, lb3_2)
                                    if time > tr.last_trig_time
                                        cand_ks_2 := true
                                        tr.c_bar := bar_index
                                        tr.last_trig_time := time
                                tr.state := 0
                            else
                                tr.state := 2
                    else
                        if f_vwap_ok(c2, ub3_2, ub2_2, ub1_2, _vwap2, lb1_2, lb2_2, lb3_2)
                            if time > tr.last_trig_time
                                trig_2 := true, fired_e2_this_bar := true, tr.c_bar := bar_index
                                tr.last_trig_time := time
                                last_e2_reclaim_bar := bar_index
                                f_draw_risk_cage(lvl, flag_col_e2, 2, close, 0, 0)
                                if alt_killshot
                                    f_alert("NXS E2: Killshot Validated at " + str.tostring(lvl), alert.freq_once_per_bar_close)
                                if use_vm
                                    line.new(bar_index + vm_shift, close - vm_ext_2, bar_index + vm_shift, close + vm_ext_2, color=vm_col, width=vm_thick)
                                if alt_line
                                    array.push(pending_vm_bars, bar_index + vm_shift), array.push(pending_vm_msgs, "NXS E2: Line in the Sand Crossed at " + str.tostring(lvl))
                                if alt_tap
                                    array.push(active_nets, f_get_target_price(alt_tap_line, 2, close)), array.push(active_net_msgs, "NXS E2: Risk Cage Tap at " + str.tostring(lvl))
                            tr.state := 0
        else if tr.state == 2
            if bar_index >= tr.stage1_bar + active_delay
                if c2 > lvl 
                    if not fired_e2_this_bar and barstate.isconfirmed
                        if f_vwap_ok(c2, ub3_2, ub2_2, ub1_2, _vwap2, lb1_2, lb2_2, lb3_2)
                            if time > tr.last_trig_time
                                trig_2 := true, fired_e2_this_bar := true, tr.c_bar := bar_index
                                tr.last_trig_time := time
                                f_draw_risk_cage(lvl, flag_col_e2, 2, close, 0, 0)
                                if alt_killshot
                                    f_alert("NXS E2: Killshot Validated at " + str.tostring(lvl), alert.freq_once_per_bar_close)
                                if use_vm
                                    line.new(bar_index + vm_shift, close - vm_ext_2, bar_index + vm_shift, close + vm_ext_2, color=vm_col, width=vm_thick)
                                if alt_line
                                    array.push(pending_vm_bars, bar_index + vm_shift), array.push(pending_vm_msgs, "NXS E2: Line in the Sand Crossed at " + str.tostring(lvl))
                                if alt_tap
                                    array.push(active_nets, f_get_target_price(alt_tap_line, 2, close)), array.push(active_net_msgs, "NXS E2: Risk Cage Tap at " + str.tostring(lvl))
                tr.state := 0 

// --- Evaluate Combined Alignment Gate for E1 & E2 Stage 1 Reclaims ---
if cand_stg1_1 or cand_stg1_2
    bool m1_e1 = cand_stg1_1 and (bar_index - last_e2_reclaim_bar <= sync_bars)
    bool m2_e1 = cand_stg1_1 and (e2_was_sweeping or f_is_sweeping(tr_2) or cand_stg1_2)
    bool m3_e1 = cand_stg1_1 and f_is_near_level(sp_2, h2, l2, sync_prox_2)

    bool m1_e2 = cand_stg1_2 and (bar_index - last_e1_reclaim_bar <= sync_bars)
    bool m2_e2 = cand_stg1_2 and (e1_was_sweeping or f_is_sweeping(tr_1) or cand_stg1_1)
    bool m3_e2 = cand_stg1_2 and f_is_near_level(sp_1, h1, l1, sync_prox_1)

    bool align_1 = sync_mode == "Mode 1: Tandem Reclaim (Within X Bars)" ? m1_e1 : sync_mode == "Mode 2: Structural Sync (Other Engine Sweeping)" ? m2_e1 : sync_mode == "Mode 3: Proximity Sync (Other Engine Near Level)" ? m3_e1 : sync_mode == "Mode 4: Any Alignment (Mode 1, 2, or 3)" ? (m1_e1 or m2_e1 or m3_e1) : false
    bool align_2 = sync_mode == "Mode 1: Tandem Reclaim (Within X Bars)" ? m1_e2 : sync_mode == "Mode 2: Structural Sync (Other Engine Sweeping)" ? m2_e2 : sync_mode == "Mode 3: Proximity Sync (Other Engine Near Level)" ? m3_e2 : sync_mode == "Mode 4: Any Alignment (Mode 1, 2, or 3)" ? (m1_e2 or m2_e2 or m3_e2) : false
    bool is_sync = sync_mode != "Off (Independent Engines)" and (align_1 or align_2)

    if is_sync
        stg1_sync := true
        int    win_e   = cand_stg1_1 ? 1 : 2
        float  win_lvl = cand_stg1_1 ? cand_lvl_1 : cand_lvl_2
        string win_src = (cand_stg1_1 and cand_stg1_2) ? (cand_src_1 + "+" + cand_src_2) : (cand_stg1_1 ? cand_src_1 : cand_src_2)
        float  win_swp = cand_stg1_1 ? cand_swp_1 : cand_swp_2
        bool   win_ks  = cand_stg1_1 ? cand_ks_1 : cand_ks_2
        float  win_vm  = win_e == 1 ? vm_ext_1 : vm_ext_2

        f_draw_risk_cage(win_lvl, flag_col_sync, win_e, close, force_x_shift, force_y_shift)
        if alt_timer
            f_alert_reclaim_card(win_e, true, win_src, win_swp, alert.freq_once_per_bar_close)
        if win_ks
            if win_e == 1
                trig_1 := true
            else
                trig_2 := true
            if alt_killshot
                f_alert("NXS SYNC: Killshot Validated at " + str.tostring(win_lvl), alert.freq_once_per_bar_close)
            if use_vm
                line.new(bar_index + vm_shift, close - win_vm, bar_index + vm_shift, close + win_vm, color=vm_col, width=vm_thick)
            if alt_line
                array.push(pending_vm_bars, bar_index + vm_shift), array.push(pending_vm_msgs, "NXS SYNC: Line in the Sand Crossed at " + str.tostring(win_lvl))
            if alt_tap
                array.push(active_nets, f_get_target_price(alt_tap_line, win_e, close)), array.push(active_net_msgs, "NXS SYNC: Risk Cage Tap at " + str.tostring(win_lvl))
    else
        bool allow_solo = (sync_mode == "Off (Independent Engines)") or not mute_solo
        if allow_solo
            if cand_stg1_1
                stg1_1 := true
                f_draw_risk_cage(cand_lvl_1, flag_col_e1, 1, close, force_x_shift, force_y_shift)
                if alt_timer
                    f_alert_reclaim_card(1, false, cand_src_1, cand_swp_1, alert.freq_once_per_bar_close)
                if cand_ks_1
                    trig_1 := true
                    if alt_killshot
                        f_alert("NXS E1: Killshot Validated at " + str.tostring(cand_lvl_1), alert.freq_once_per_bar_close)
                    if use_vm
                        line.new(bar_index + vm_shift, close - vm_ext_1, bar_index + vm_shift, close + vm_ext_1, color=vm_col, width=vm_thick)
                    if alt_line
                        array.push(pending_vm_bars, bar_index + vm_shift), array.push(pending_vm_msgs, "NXS E1: Line in the Sand Crossed at " + str.tostring(cand_lvl_1))
                    if alt_tap
                        array.push(active_nets, f_get_target_price(alt_tap_line, 1, close)), array.push(active_net_msgs, "NXS E1: Risk Cage Tap at " + str.tostring(cand_lvl_1))
            if cand_stg1_2
                stg1_2 := true
                // Only draw a second risk cage on the exact same bar if E1 didn't already draw one
                if not cand_stg1_1
