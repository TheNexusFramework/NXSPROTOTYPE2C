    string src_str = ""
    int t_formed = 0
    if not na(trackers) and array.size(trackers) > 0
        for i = 0 to array.size(trackers) - 1
            LevelTracker tr = array.get(trackers, i)
            if tr.price == chk_price
                src_str := tr.source
                t_formed := tr.time_formed
                if tr.time_formed > 0 and (time - tr.time_formed) <= (fresh_days * 86400000)
                    is_fresh := true
                break
    [is_fresh, src_str, t_formed]

