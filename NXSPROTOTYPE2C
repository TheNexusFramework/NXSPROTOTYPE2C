                                tr.state := 0
                            else
                                tr.state := 2
                    else
                        if f_vwap_ok(c3, ub3_3, ub2_3, ub1_3, _vwap3, lb1_3, lb2_3, lb3_3)
                            if time > tr.last_trig_time
                                trig_3 := true, fired_e3_this_bar := true, tr.c_bar := bar_index
                                tr.last_trig_time := time
                                f_draw_risk_cage(lvl, flag_col_e3, 3, close, 0, 0)
                                if alt_killshot
                                    f_alert("NXS E3: Killshot Validated at " + str.tostring(lvl), alert.freq_once_per_bar_close)
