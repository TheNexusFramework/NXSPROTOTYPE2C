f_commit_cluster(cluster_arr, tr_arr, sp_arr, min_dist) =>
    if array.size(cluster_arr) > 0
        RawLevel chosen = array.get(cluster_arr, 0)
        if array.size(cluster_arr) > 1
            for c_idx = 1 to array.size(cluster_arr) - 1
                RawLevel temp = array.get(cluster_arr, c_idx)
                if temp.tier < chosen.tier
                    chosen := temp
        if array.size(sp_arr) == 0
            array.push(tr_arr, LevelTracker.new(chosen.price, chosen.source, 0, 0.0, -cooldown, 0, chosen.time_formed, chosen.c, chosen.s, chosen.w, chosen.tier, 0, 0))
            array.push(sp_arr, chosen.price)
        else
            int last_idx = array.size(sp_arr) - 1
            float prev_p = array.get(sp_arr, last_idx)
            if math.abs(chosen.price - prev_p) > min_dist
                array.push(tr_arr, LevelTracker.new(chosen.price, chosen.source, 0, 0.0, -cooldown, 0, chosen.time_formed, chosen.c, chosen.s, chosen.w, chosen.tier, 0, 0))
                array.push(sp_arr, chosen.price)
            else
                // Adjacent cluster winner is still within min_dist of previous locked level: keep higher priority tier
                LevelTracker prev_tr = array.get(tr_arr, last_idx)
                if chosen.tier < prev_tr.tier
                    array.set(tr_arr, last_idx, LevelTracker.new(chosen.price, chosen.source, 0, 0.0, -cooldown, 0, chosen.time_formed, chosen.c, chosen.s, chosen.w, chosen.tier, 0, 0))
